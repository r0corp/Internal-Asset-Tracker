# Copy this file to .env and fill in a real value.
# Generate a random SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional - defaults to a local SQLite file at instance/asset.db
# DATABASE_URL=postgresql://user:password@localhost/asset_tracker

# Optional - set to False to disable login rate limiting (default True)
# RATELIMIT_ENABLED=True
